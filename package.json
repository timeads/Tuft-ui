{
  "name": "tuft-ui",
  "version": "0.1.3",
  "description": "Shared look for the Tuft Life internal apps: brand tokens, fonts, shadcn/Tailwind theme and the <tuft-rail> app switcher.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": "github:timeads/tuft-ui",
  "files": ["css", "fonts", "img", "rail", "tailwind", "tokens.json", "DESIGN.md"],
  "exports": {
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*",
    "./img/*": "./img/*",
    "./rail": {
      "types": "./rail/tuft-rail.d.ts",
      "default": "./rail/tuft-rail.js"
    },
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./tailwind/palettes": "./tailwind/palettes.cjs",
    "./tailwind/v4.css": "./tailwind/v4.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check && node --test"
  }
}
